diff --git a/config/scripts/vitest-bun-node-builtins.ts b/config/scripts/vitest-bun-node-builtins.ts
--- a/config/scripts/vitest-bun-node-builtins.ts
+++ b/config/scripts/vitest-bun-node-builtins.ts
@@ -26,7 +26,24 @@
   const homedir = () =>
     (process.platform === 'win32' ? process.env.USERPROFILE : process.env.HOME) ?? os.homedir()
 
-  vi.doMock('node:os', () => ({ ...os, homedir, default: { ...os, homedir } }))
-  vi.doMock('node:fs', () => ({ ...fs, default: fs }))
-  vi.doMock('node:fs/promises', () => ({ ...fs.promises, default: fs.promises }))
+  if (typeof vi.doMock === 'function') {
+    vi.doMock('node:os', () => ({ ...os, homedir, default: { ...os, homedir } }))
+    vi.doMock('node:fs', () => ({ ...fs, default: fs }))
+    vi.doMock('node:fs/promises', () => ({ ...fs.promises, default: fs.promises }))
+  } else if (typeof vi.mock === 'function') {
+    const mockNodeBuiltin = vi.mock
+    const originalHomedir = os.homedir
+    const nativeHomedir = () =>
+      (process.platform === 'win32' ? process.env.USERPROFILE : process.env.HOME) ?? originalHomedir()
+
+    mockNodeBuiltin('node:os', () => ({
+      ...os,
+      homedir: nativeHomedir,
+      default: { ...os, homedir: nativeHomedir }
+    }))
+    mockNodeBuiltin('node:fs', () => ({ ...fs, default: fs }))
+    mockNodeBuiltin('node:fs/promises', () => ({ ...fs.promises, default: fs.promises }))
+  } else {
+    throw new Error('Bun test module mocks are unavailable; the Node builtin guards cannot be published')
+  }
 }
