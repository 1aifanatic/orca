{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "//#build:electron-vite": {
      "inputs": [
        "src/**",
        "config/**",
        "resources/**",
        "electron.vite.config.ts",
        "package.json",
        "pnpm-lock.yaml",
