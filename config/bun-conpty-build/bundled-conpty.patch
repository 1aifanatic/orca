+// Local prototype: not compiled or ready to ship.
+#[cfg(windows)]
+#[derive(Clone, Copy)]
+struct ConptyApi {
+    create: unsafe extern "system" fn(windows::COORD, windows::HANDLE, windows::HANDLE, u32, *mut windows::HPCON) -> i32,
+    resize: unsafe extern "system" fn(windows::HPCON, windows::COORD) -> i32,
+    close: unsafe extern "system" fn(windows::HPCON),
+    release: Option<unsafe extern "system" fn(windows::HPCON) -> i32>,
+}
+
+#[cfg(windows)]
+impl ConptyApi {
+    fn selected() -> Result<Self, CreatePtyError> {
+        static API: std::sync::OnceLock<Result<ConptyApi, ()>> = std::sync::OnceLock::new();
+        API.get_or_init(Self::load).as_ref().copied().map_err(|_| CreatePtyError::OpenPtyFailed)
+    }
+
+    fn load() -> Result<Self, ()> {
+        let Some(bytes) = bun_core::env_var::BUN_CONPTY_LIBRARY::get() else {
+            return Ok(Self {
+                create: windows::CreatePseudoConsole,
+                resize: windows::ResizePseudoConsole,
+                close: windows::ClosePseudoConsole,
+                release: None,
+            });
+        };
+        let path = core::str::from_utf8(bytes).map_err(|_| ())?;
+        if path.contains('\0') || !std::path::Path::new(path).is_absolute() {
+            return Err(());
+        }
+        use std::os::windows::ffi::OsStrExt;
+        let wide: Vec<u16> = std::ffi::OsStr::new(path).encode_wide().chain(Some(0)).collect();
+        // Limit dependency lookup to the selected DLL's directory and System32.
+        let library = unsafe { windows::LoadLibraryExW(wide.as_ptr(), core::ptr::null_mut(), 0x100 | 0x800) };
+        if library.is_null() {
+            return Err(());
+        }
+        struct LibraryGuard(windows::HMODULE);
+        impl Drop for LibraryGuard {
+            fn drop(&mut self) {
+                unsafe { FreeLibrary(self.0); }
+            }
+        }
+        let guard = LibraryGuard(library);
+        macro_rules! symbol {
+            ($name:literal, $ty:ty) => {{
+                let address = unsafe { windows::GetProcAddress(library, concat!($name, "\0").as_ptr().cast()) };
+                if address.is_null() {
+                    return Err(());
+                }
+                // All names use the pinned Microsoft ConPTY ABI; the module stays resident.
+                unsafe { core::mem::transmute::<*mut core::ffi::c_void, $ty>(address) }
+            }};
+        }
+        // Keep one module resident for process lifetime, including off-thread closes.
+        let api = Self {
+            create: symbol!("ConptyCreatePseudoConsole", unsafe extern "system" fn(windows::COORD, windows::HANDLE, windows::HANDLE, u32, *mut windows::HPCON) -> i32),
+            resize: symbol!("ConptyResizePseudoConsole", unsafe extern "system" fn(windows::HPCON, windows::COORD) -> i32),
+            close: symbol!("ConptyClosePseudoConsole", unsafe extern "system" fn(windows::HPCON)),
+            release: Some(symbol!("ConptyReleasePseudoConsole", unsafe extern "system" fn(windows::HPCON) -> i32)),
+        };
+        core::mem::forget(guard);
+        Ok(api)
+    }
+}
+
+#[cfg(windows)]
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn FreeLibrary(module: windows::HMODULE) -> i32;
+}
